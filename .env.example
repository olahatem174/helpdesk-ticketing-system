# Server
NODE_ENV=development
PORT=5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=helpdesk_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Email — set EMAIL_MOCK=true for local dev (logs to console, no SMTP needed)
EMAIL_MOCK=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=HelpDesk Pro <noreply@helpdesk.com>

# React (must start with REACT_APP_)
REACT_APP_API_URL=http://localhost:5000/api
